+void nsCocoaWindow::SetWindowClass(const nsAString& aXulWinType,
+                                   const nsAString& aXulWinClass,
+                                   const nsAString& aXulWinName) {
+  if (mWindowType != WindowType::TopLevel || mIsBrowserWindow ||
+      !aXulWinType.EqualsLiteral("navigator:browser")) {
+    return;
+  }
+  mIsBrowserWindow = true;
+  Preferences::RegisterCallback(ZenWindowVibrancyPrefChanged,
+                                "zen.widget.macos.window-vibrancy", this);
+  UpdateWindowMaterial();
+}
+
+void nsCocoaWindow::UpdateWindowMaterial() {
+  NS_OBJC_BEGIN_TRY_IGNORE_BLOCK;
+
+  if (!mWindow) {
+    return;
+  }
+  bool wanted = StaticPrefs::zen_widget_macos_window_vibrancy();
+  if (wanted ==
+      [mWindow.contentView isKindOfClass:[ZenWindowMaterialView class]]) {
+    return;
+  }
+
+  NSRect frame = mWindow.contentView.frame;
+  NSView* wrapper = wanted ? [[ZenWindowMaterialView alloc] initWithFrame:frame]
+                           : [[NSView alloc] initWithFrame:frame];
+  wrapper.wantsLayer = YES;
+  for (NSView* view in [mWindow contentViewContents]) {
+    [view removeFromSuperviewWithoutNeedingDisplay];
+    [wrapper addSubview:view];
+  }
+  mWindow.contentView = wrapper;
+  [wrapper release];
+  mWindowMaterialHole = LayoutDeviceIntRect();
+
+  NS_OBJC_END_TRY_IGNORE_BLOCK;
+}
+
+// Cut a hole in the material under the opaque page, so the window server does
+// not blend the blur under every page frame. The hole stops kHoleInset points
+// inside the page, which keeps the blur under its rounded corners and covers a
+// frame of lag while the page moves.
+void nsCocoaWindow::UpdateOpaqueRegion(const LayoutDeviceIntRegion& aRegion) {
+  NS_OBJC_BEGIN_TRY_IGNORE_BLOCK;
+
+  MOZ_LOG(sCocoaLog, LogLevel::Verbose,
+          ("nsCocoaWindow::UpdateOpaqueRegion %u rects, bounds %d,%d %dx%d",
+           aRegion.GetNumRects(), aRegion.GetBounds().x, aRegion.GetBounds().y,
+           aRegion.GetBounds().width, aRegion.GetBounds().height));
+
+  // ponytail: holes only the largest opaque rect, one hole per split view
+  // pane if the split scenario measures worse than a single page.
+  LayoutDeviceIntRect hole;
+  if (StaticPrefs::zen_widget_macos_window_material_hole()) {
+    for (auto iter = aRegion.RectIter(); !iter.Done(); iter.Next()) {
+      if (iter.Get().Area() > hole.Area()) {
+        hole = iter.Get();
+      }
+    }
+  }
+  if (hole.IsEqualEdges(mWindowMaterialHole)) {
+    return;
+  }
+  mWindowMaterialHole = hole;
+
+  if (!mWindow || !mChildView ||
+      ![mWindow.contentView isKindOfClass:[ZenWindowMaterialView class]]) {
+    return;
+  }
+  auto* view = (ZenWindowMaterialView*)mWindow.contentView;
+  NSRect bounds = view.bounds;
+  // ponytail: fixed 16pt margin, make it a pref if strips show at the page
+  // edge during sidebar or split resizes.
+  constexpr CGFloat kHoleInset = 16.0;
+  NSRect rect = NSIntersectionRect(
+      NSInsetRect([mChildView convertRect:DevPixelsToCocoaPoints(hole)
+                                   toView:view],
+                  kHoleInset, kHoleInset),
+      bounds);
+  if (hole.IsEmpty() || NSWidth(rect) < 1.0 || NSHeight(rect) < 1.0) {
+    view.maskImage = nil;
+    return;
+  }
+
+  // The mask is opaque where the material shows. Its caps keep their size and
+  // its clear middle point stretches over the hole.
+  CGFloat left = ceil(NSMinX(rect) - NSMinX(bounds));
+  CGFloat right = ceil(NSMaxX(bounds) - NSMaxX(rect));
+  CGFloat top = ceil(view.isFlipped ? NSMinY(rect) - NSMinY(bounds)
+                                    : NSMaxY(bounds) - NSMaxY(rect));
+  CGFloat bottom = ceil(view.isFlipped ? NSMaxY(bounds) - NSMaxY(rect)
+                                       : NSMinY(rect) - NSMinY(bounds));
+  NSImage* mask =
+      [NSImage imageWithSize:NSMakeSize(left + 1 + right, top + 1 + bottom)
+                     flipped:NO
+              drawingHandler:^BOOL(NSRect aDstRect) {
+                [NSColor.blackColor set];
+                NSRectFill(aDstRect);
+                NSRectFillUsingOperation(NSMakeRect(left, bottom, 1, 1),
+                                         NSCompositingOperationClear);
+                return YES;
+              }];
+  mask.capInsets = NSEdgeInsetsMake(top, left, bottom, right);
+  mask.resizingMode = NSImageResizingModeStretch;
+  view.maskImage = mask;
+  MOZ_LOG(sCocoaLog, LogLevel::Debug,
+          ("nsCocoaWindow::UpdateOpaqueRegion hole %d,%d %dx%d", hole.x,
+           hole.y, hole.width, hole.height));
+
+  NS_OBJC_END_TRY_IGNORE_BLOCK;
+}
