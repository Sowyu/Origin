diff --git a/toolkit/mozapps/update/UpdateService.sys.mjs b/toolkit/mozapps/update/UpdateService.sys.mjs
index 1166c7b232e502cd2c5bf713c122962c2242216b..76bd730491aec5d7b0c1e7a87c96eb9663a7bb1e 100644
