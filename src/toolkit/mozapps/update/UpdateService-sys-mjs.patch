+++ b/toolkit/mozapps/update/UpdateService.sys.mjs
@@ -1957,9 +1957,15 @@ function updateIsAtLeastAsOldAs(update, version, buildID) {
     return false;
   }
   let versionComparison = Services.vc.compare(update.appVersion, version);
+  // Origin ships several builds under one version, so with equal versions only
+  // a later build ID is an update; the feed must never move a newer build back.
+  const olderBuild =
+    /^\d{14}$/.test(update.buildID) &&
+    /^\d{14}$/.test(buildID) &&
+    update.buildID < buildID;
   return (
     versionComparison < 0 ||
