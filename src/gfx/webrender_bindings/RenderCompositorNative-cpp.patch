+  if (StaticPrefs::zen_widget_macos_release_idle_tile_buffers()) {
+    // ponytail: fixed idle window, checked only when a frame composites, so a
+    // window that stops compositing keeps the spares of its last 10 frames.
+    // Add a timer if measurements show those matter.
+    const uint64_t kIdleFrames = 10;
