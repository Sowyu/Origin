@@ -1944,6 +1944,12 @@ struct NewLayerData {
 static Maybe<nsPoint> AllowComputingOpaqueRegionAcross(
     nsDisplayItem* aWrappingItem, nsDisplayListBuilder* aBuilder) {
   MOZ_ASSERT(aWrappingItem);
+  // Origin: WrapBackgroundColorInOwnLayer puts a remote browser's background
+  // in an own layer that does not move it, so the page counts as opaque.
+  if (aWrappingItem->GetType() == DisplayItemType::TYPE_OWN_LAYER &&
+      aWrappingItem->Frame()->IsSubDocumentFrame()) {
+    return Some(nsPoint());
+  }
   if (aWrappingItem->GetType() != DisplayItemType::TYPE_TRANSFORM) {
     return {};
   }
