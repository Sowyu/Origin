index 5760a816612bfc85f73178f5231268f6fb3861f4..f8c1db4c8f4974111cc3422c0ff1fb57d92eadd4 100644
--- a/gfx/layers/NativeLayerCA.mm
+++ b/gfx/layers/NativeLayerCA.mm
@@ -28,6 +28,7 @@
 #include "MozFramebuffer.h"
 #include "ScopedGLHelpers.h"
 #include "mozilla/StaticPrefs_gfx.h"
+#include "mozilla/StaticPrefs_zen.h"
 #include "mozilla/gfx/Swizzle.h"
 #include "mozilla/glean/GfxMetrics.h"
 #include "mozilla/layers/ScreenshotGrabber.h"
@@ -1967,9 +1968,32 @@ CGColorRef CGColorCreateForDeviceColor(const gfx::DeviceColor& aColor) {
         rrClipRect.origin.x -= useClipRect.origin.x;
         rrClipRect.origin.y -= useClipRect.origin.y;
 
-        mRoundedClipCALayer.cornerRadius = effectiveRadius / aBackingScale;
-        mRoundedClipCALayer.masksToBounds = YES;
-        mRoundedClipCALayer.maskedCorners = maskedCorners;
+        // A layer that is masked to rounded corners may not count as an
+        // opaque occluder, so only mask tiles that reach into a corner.
+        // ponytail: tests all four corner squares even if only some are
+        // rounded, check maskedCorners if partly rounded clips show up.
+        bool roundCorners = true;
+        CGRect visibleRect =
+            CGRectMake(0, 0, useClipRect.size.width, useClipRect.size.height);
+        if (StaticPrefs::zen_widget_macos_round_corner_tiles_only() &&
+            scaledClipRect.isSome()) {
+          CGFloat radius = effectiveRadius / aBackingScale;
+          CGRect visibleInClip = CGRectIntersection(visibleRect, rrClipRect);
+          roundCorners =
+              !CGRectContainsRect(CGRectInset(rrClipRect, radius, 0),
+                                  visibleInClip) &&
+              !CGRectContainsRect(CGRectInset(rrClipRect, 0, radius),
+                                  visibleInClip);
+        }
+
+        if (roundCorners) {
+          mRoundedClipCALayer.cornerRadius = effectiveRadius / aBackingScale;
+          mRoundedClipCALayer.masksToBounds = YES;
+          mRoundedClipCALayer.maskedCorners = maskedCorners;
+        } else {
+          mRoundedClipCALayer.masksToBounds =
+              !CGRectContainsRect(rrClipRect, visibleRect);
+        }
       }
     }
 
