{
  "_comment": "One Zen visual effect turned off per variant, on top of the standard template. Switches come from docs/research/zen-effects-2026-10-12.md. 'scenarios' lists where the effect can cost something. Variants with no scenarios are memory settings for Firefox and Zen alike, which m1-batches skips and the memory batch runs on idle.",
  "no-vibrancy": {
    "what": "native window material (ZenWindowMaterialView) replaced by a plain view",
    "prefs": {"zen.widget.macos.window-vibrancy": false},
    "scenarios": ["idle", "switch", "scroll", "video-windowed"]
  },
  "no-gradient": {
    "what": "workspace gradient layers hidden",
    "userchrome": "#zen-browser-background::before, #zen-browser-background::after, #zen-toolbar-background::before, #zen-toolbar-background::after { display: none !important; }\n",
    "scenarios": ["idle", "switch", "scroll"]
  },
  "no-page-shadow": {
    "what": "shadow of the floating page",
    "userchrome": "#tabbrowser-tabpanels .browserSidebarContainer { box-shadow: none !important; }\n",
    "scenarios": ["idle", "scroll", "video-windowed"]
  },
  "no-page-radius": {
    "what": "rounded corners of the floating page",
    "userchrome": "#tabbrowser-tabpanels .browserSidebarContainer { border-radius: 0 !important; }\n",
    "scenarios": ["idle", "scroll", "video-windowed"]
  },
  "no-squircle": {
    "what": "squircle corner shapes across the UI",
    "prefs": {"layout.css.corner-shape.enabled": false},
    "scenarios": ["idle", "scroll"]
  },
  "no-space-animation": {
    "what": "workspace switch animation",
    "prefs": {"zen.workspaces.switch-animation-duration": 0},
    "scenarios": ["switch"]
  },
  "reduced-motion": {
    "what": "Reduce Motion as the system setting would set it (many animations at once). Not in the effects batch: it also changes what every website sees, so Origin would not ship it",
    "prefs": {"ui.prefersReducedMotion": 1},
    "scenarios": []
  },
  "no-compact-animation": {
    "what": "compact mode sidebar slide",
    "prefs": {"zen.view.compact.animate-sidebar": false},
    "scenarios": ["sidebar"]
  },
  "no-essentials-bg": {
    "what": "blurred favicon background behind Essentials",
    "prefs": {"zen.theme.essentials-favicon-bg": false},
    "scenarios": ["idle", "switch"]
  },
  "no-loading-bar": {
    "what": "Zen's page loading bar",
    "prefs": {"zen.view.enable-loading-indicator": false},
    "scenarios": ["launch"]
  },
  "no-native-popovers": {
    "what": "native NSPopover arrow panels (Zen turns them on; Firefox ships them off)",
    "prefs": {"widget.macos.native-popovers": false},
    "scenarios": ["idle"]
  },
  "min-visual": {
    "what": "every effect above off at once, except reduced-motion: the lower bound for Zen's look",
    "prefs": {"zen.widget.macos.window-vibrancy": false, "layout.css.corner-shape.enabled": false,
              "zen.workspaces.switch-animation-duration": 0, "zen.view.compact.animate-sidebar": false,
              "zen.theme.essentials-favicon-bg": false, "zen.view.enable-loading-indicator": false,
              "widget.macos.native-popovers": false},
    "userchrome": "#zen-browser-background::before, #zen-browser-background::after, #zen-toolbar-background::before, #zen-toolbar-background::after { display: none !important; }\n#tabbrowser-tabpanels .browserSidebarContainer { box-shadow: none !important; border-radius: 0 !important; }\n",
    "scenarios": ["switch", "scroll", "video-windowed", "sidebar", "split"]
  },
  "on-demand": {
    "what": "only the selected tab loads at startup, as Firefox ships it for normal tabs, and pinned tabs wait too: what unloading background tabs leaves",
    "prefs": {"browser.sessionstore.restore_on_demand": true, "browser.sessionstore.restore_pinned_tabs_on_demand": true},
    "scenarios": []
  },
  "lean-memory": {
    "what": "on-demand plus no spare content processes (Firefox keeps 3 ready) and no preloaded new tab page",
    "prefs": {"browser.sessionstore.restore_on_demand": true, "browser.sessionstore.restore_pinned_tabs_on_demand": true,
              "dom.ipc.processPrelaunch.enabled": false, "browser.newtab.preload": false},
    "scenarios": []
  },
  "unload-1min": {
    "what": "Origin's tab unloader at 1 minute: the idle scenario settles 150 s, so it measures memory after background tabs unload",
    "prefs": {"origin.tabs.unload-after-minutes": 1},
    "scenarios": []
  },
  "quiet-newtab": {
    "what": "Firefox's new tab machinery kept as quiet as prefs allow: blank homepage and new tab page, the 12 low-risk widget feeds and the wallpaper fetch off (docs/research/newtab-2026-10-13.md)",
    "prefs": {"browser.startup.homepage": "about:blank",
              "browser.newtabpage.enabled": false,
              "browser.newtabpage.activity-stream.newtabWallpapers.enabled": false,
              "browser.newtabpage.activity-stream.newtabWallpapers.v2.enabled": false,
              "browser.newtabpage.activity-stream.feeds.weatherfeed": false,
              "browser.newtabpage.activity-stream.feeds.stocksfeed": false,
              "browser.newtabpage.activity-stream.feeds.adsfeed": false,
              "browser.newtabpage.activity-stream.feeds.inferredpersonalizationfeed": false,
              "browser.newtabpage.activity-stream.feeds.smartshortcutsfeed": false,
              "browser.newtabpage.activity-stream.feeds.newtabattributionfeed": false,
              "browser.newtabpage.activity-stream.feeds.listsfeed": false,
              "browser.newtabpage.activity-stream.feeds.privacyfeed": false,
              "browser.newtabpage.activity-stream.feeds.recentsearchesfeed": false,
              "browser.newtabpage.activity-stream.feeds.pictureofthedayfeed": false,
              "browser.newtabpage.activity-stream.feeds.timerfeed": false,
              "browser.newtabpage.activity-stream.feeds.webnotificationsfeed": false},
    "scenarios": []
  }
}
