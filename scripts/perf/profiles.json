{
  "_comment": "Prefs the harness writes into every Gecko profile, at template creation and again before every run. Each one removes a first-run prompt or makes runs repeatable. Two change Zen's startup on purpose: restore_pinned_tabs_on_demand false loads Essentials (the idle scenario has 10 loaded tabs), and continue-where-left-off true reopens the last tab instead of Zen's empty tab with the URL bar focused (the idle scenario has no text field focused). 'setup' prefs exist only while Marionette builds the template.",
  "common": {
    "browser.shell.checkDefaultBrowser": false,
    "browser.startup.page": 3,
    "browser.sessionstore.restore_on_demand": false,
    "browser.warnOnQuit": false,
    "browser.warnOnQuitShortcut": false,
    "browser.tabs.warnOnClose": false,
    "browser.aboutwelcome.enabled": false,
    "browser.startup.homepage_override.mstone": "ignore",
    "startup.homepage_welcome_url": "",
    "startup.homepage_welcome_url.additional": "",
    "startup.homepage_override_url": "",
    "trailhead.firstrun.didSeeAboutWelcome": true,
    "datareporting.policy.dataSubmissionPolicyBypassNotification": true,
    "toolkit.legacyUserProfileCustomizations.stylesheets": true,
    "browser.sessionstore.restore_pinned_tabs_on_demand": false
  },
  "zen": {
    "zen.welcome-screen.seen": true,
    "zen.updates.show-update-notification": false,
    "zen.workspaces.continue-where-left-off": true
  },
  "firefox": {},
  "setup": {
    "marionette.port": 2828,
    "remote.prefs.recommended": false
