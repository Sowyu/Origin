#
# The measurements in one unattended chain, most important first:
# 1. baseline-1: every scenario, 3 runs, official Zen, stock Zen, Firefox, Safari and a
#    no-browser floor.
# 2. origin-1: Origin on every scenario. Where something moves, stock Zen runs interleaved as a
#    control, and so does Origin with every Zen effect off (min-visual), so the comparison is safe
#    from drift and from other apps on the Mac (T3 Code's service shows up in whole-Mac power).
#    Stock Zen runs interleaved in the other scenarios too, and the no-browser floor again.
# 3. memory-1: idle with only the selected tab loaded (on-demand), with and without spare
#    processes (lean-memory; Origin has those prefs built in), and Origin's tab unloader set to
#    one minute (unload-1min).
# 4. profiler-1: RefreshDriverTick markers at idle and minimized, Origin included.
# 5. effects-1: each Zen effect turned off on its own in stock Zen, plus all of them at once,
#    per scenario with stock Zen as an interleaved control. Idle is left out because baseline-1
#    puts Zen at the no-browser floor there (app 0 mW, WindowServer within 1 mW), which bounds
#    what any effect costs at idle. Launch is left out because its only effect is cut.
# Settle is 150 s: calibration (batch calib-1) found one-off startup bursts of 250-560 mW with
# 4-6 MB of writes up to 124 s after launch. Every step resumes where it stopped, so rerunning
# the chain after a crash only measures what is missing. scripts/perf/hold pauses it between
# runs while a build runs.
# Usage: scripts/detach m1 scripts/perf/m1-batches
set -u
here="$(cd "$(dirname "$0")" && pwd)"
BROWSERS="${BROWSERS:-zen-official,zen-stock,firefox}"
SETTLE="${SETTLE:-150}"
# ponytail: agents share this Mac, so the quiet wait allows a load of 8; every comparison runs
# interleaved with a control, raise MAXLOAD back to 3.5 when the Mac is quiet.
MAXLOAD="${MAXLOAD:-8}"
ACTIVE="switch,scroll,video-windowed,sidebar,split"
run() { "$here/run" --settle "$SETTLE" --max-load "$MAXLOAD" "$@" || echo "step failed: $*"; }

run --batch baseline-1 --browsers "none,$BROWSERS,safari" --scenarios all --runs 3

run --batch origin-1 --browsers zen-stock,origin,origin+min-visual --scenarios "$ACTIVE" --runs 3
run --batch origin-1 --browsers none,zen-stock,origin --scenarios all --runs 3
run --batch origin-1 --browsers origin,origin+quiet-newtab --scenarios launch,idle --runs 3

run --batch memory-1 --browsers firefox+on-demand,firefox+lean-memory,zen-stock+on-demand,zen-stock+lean-memory,origin+on-demand,origin+unload-1min --scenarios idle --runs 3

run --batch profiler-1 --browsers "$BROWSERS,origin" --scenarios idle,minimized --runs 2 --profiler

/usr/bin/python3 - "$here/variants.json" > /tmp/zo-effects-plan.txt <<'PY'
import json, sys
SKIP = {"idle", "launch"}
# origin_only variants need Origin's patches, so they mean nothing on stock Zen.
v = {k: d for k, d in json.load(open(sys.argv[1])).items() if not k.startswith("_") and not d.get("origin_only")}
scenarios = []
for d in v.values():
    scenarios += [s for s in d["scenarios"] if s not in scenarios and s not in SKIP]
for s in scenarios:
    print(s, ",".join(["zen-stock"] + [f"zen-stock+{k}" for k, d in v.items() if s in d["scenarios"]]))
PY
while read -r scen configs; do
  run --batch effects-1 --browsers "$configs" --scenarios "$scen" --runs 3
done < /tmp/zo-effects-plan.txt

echo "m1 chain done"
