#!/bin/sh
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at http://mozilla.org/MPL/2.0/.
#
# Builds Origin from a clean engine: Firefox's own files back to pristine, files that patches add
# and symlinks to deleted src files removed, then build-zen's import, locales, build and package
# phases, so every patch applies from scratch after cuts. While measurement batches run, start it
# through the hold:  scripts/detach build-origin scripts/perf/hold scripts/build-origin
set -eu
cd "$(dirname "$0")/.."
echo "reset engine to Firefox $(date +%T)"
git -C engine checkout -q -- .
/usr/bin/python3 - <<'PY'
import glob, os, re, subprocess
added = set()
for p in glob.glob("src/**/*.patch", recursive=True):
    cur = None
    for line in open(p, errors="replace"):
        m = re.match(r"diff --git a/(\S+) b/(\S+)", line)
        if m:
            cur = m.group(2)
        elif line.startswith("new file mode") and cur:
            added.add(cur)
out = subprocess.run(["git", "-C", "engine", "ls-files", "--others", "--exclude-standard", "--", *sorted(added)],
                     capture_output=True, text=True, check=True).stdout.split()
for f in out:
    os.remove(os.path.join("engine", f))
print(f"removed {len(out)} files that patches add")
PY
echo "dangling symlinks removed: $(find engine/zen engine/browser -type l ! -exec test -e {} \; -print -delete | wc -l | tr -d ' ')"
# Arguments go to build-zen as they are (options, then phases). Without any it runs the usual chain.
[ $# -gt 0 ] || set -- import locales build package
exec scripts/build-zen "$@"
